# Copy to .env and edit. Read by docker compose and by local runs.

# ── API ───────────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:////data/concepts.db
JWT_SECRET=change-me-in-production
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=admin
TOKEN_EXPIRE_HOURS=24

# JSON-Schema folder (source of truth for validation / supported types).
SCHEMA_DIR=/srv/schemas

# Message stamped on the first imported config of a reference variable...
IMPORT_MESSAGE=Imported from reference dataset
# ...and on the version the import mints when a variable's definition moved upstream.
SYNC_IMPORT_MESSAGE=Automated sync from upstream reference
# Reference datasets imported beside the primary one (IMPORT_SOURCE_KEY + REFERENCE_VARS_FILE),
# as a JSON array. Leave this OUT to keep the shipped default — the reprodICU mappings; set it
# to [] to import the primary dataset alone. Commented, because an empty value is not valid JSON:
# Each entry takes "source" and "vars", plus an optional "units" and "pointers" (the latter a
# {variable: {taxonomy: [identifier, ...]}} map, imported as import-owned taxonomy names):
# REFERENCE_DATASETS=[{"source": "reprodicu", "vars": "reference/reprodicu_vars.json", "units": "reference/reprodicu_units.json", "pointers": "reference/reprodicu_pointers.json"}]
# Shared secret guarding the internal ops routes (POST /internal/reimport and
# /internal/variables/upsert; api <-> vars-sync only). Empty = both are 404.
INTERNAL_TOKEN=
# Set to PRODUCTION on a deployment whose database is the system of record: refuses the
# destructive ?force=true reimport (which wipes the concept graph). See README_DEV.md.
# MODE=PRODUCTION
# Types this deployment maintains by POSTing rows to /internal/variables/upsert rather than
# through the reference files. Excluded from the file import's missing-upstream report, which
# would otherwise name every one of them on every poll. JSON array, e.g.:
# EXTERNALLY_MANAGED_TYPES=["medication", "laboratory"]
# Shared secret the web-app BFF sends as X-App-Secret to mark internal (project-free)
# concept requests. The SAME value must be set for both the api and the frontend. Empty ⇒
# no request is trusted as app-originated (external clients must always name a project).
APP_SHARED_SECRET=

# ── LDAP directory sign-in (optional) ─────────────────────────────────────────
# Off by default: the bootstrap admin logs in with a local password. Point these at your
# institution's directory to let directory users sign in (see api/config.py for details).
LDAP_ENABLED=false
# LDAPS URI, e.g. ldaps://ldap.example.org:636
LDAP_SERVER_URI=
# Base DN scoped to the canonical person roster, e.g. ou=people,dc=example,dc=org
LDAP_SEARCH_BASE=
# Immutable per-person attribute used as the stable join key:
# entryUUID (OpenLDAP), objectGUID (Active Directory), or a vendor equivalent.
LDAP_GUID_ATTRIBUTE=entryUUID
# Service account for the directory *search* step; empty ⇒ anonymous bind.
LDAP_SEARCH_BIND_DN=
LDAP_SEARCH_BIND_PASSWORD=
# CA bundle to validate the LDAPS certificate. Empty disables validation — dev only,
# ALWAYS set this in production.
LDAP_TLS_CA_CERTS_FILE=

# ── Email notifications via Exchange Web Services (optional) ──────────────────
# Sends approval notifications from a shared functional mailbox. Verify the login with:
#   docker compose exec api python -m api.mail_check
EXCHANGE_ENABLED=false
# Exchange host, e.g. mail.example.org (EWS endpoint: https://<host>/EWS/Exchange.asmx)
EXCHANGE_SERVER=
# Login account (often NOT the mailbox address; mail_check suggests working spellings).
EXCHANGE_USERNAME=
EXCHANGE_PASSWORD=
# The functional mailbox to send as (opened via delegate access).
EXCHANGE_MAILBOX=
EXCHANGE_AUTH_TYPE=NTLM
# Product name + contact address used in the notification emails.
APP_DISPLAY_NAME=Concepts Browser
CONTACT_EMAIL=

# ── Frontend ──────────────────────────────────────────────────────────────────
# Set to the real https URL behind your reverse proxy in production.
FRONTEND_ORIGIN=http://localhost:3000

# Branding overrides (see app/src/lib/brand.ts). Empty ⇒ shipped defaults; the literal
# value `none` hides optional elements (footer, API docs link, directory logo). Asset
# paths point into the app's /brand/ static dir, which a deployment can also replace
# wholesale with a bind-mount (fonts, background, logos) — no rebuild needed.
PUBLIC_APP_NAME=
PUBLIC_LOGIN_HINT=
PUBLIC_API_DOCS_URL=
PUBLIC_BRAND_LOGO=
PUBLIC_BRAND_LOGO_DARK=
PUBLIC_BRAND_BACKGROUND=
PUBLIC_FOOTER_TEXT=
PUBLIC_FOOTER_LOGO=
PUBLIC_FOOTER_LOGO_DARK=
PUBLIC_FOOTER_URL=
PUBLIC_DIRECTORY_LOGO=
PUBLIC_DIRECTORY_LOGO_DARK=
# Issue tracker the concept page's "Report issue" button files against. A URL template;
# `{tax_name}` and `{concept_name}` are substituted (percent-encoded) with the taxonomy and
# concept the reader is looking at. Prefill the rest on the tracker's side (issue form /
# template). Empty ⇒ no button is shown. Example:
# PUBLIC_GITHUB_ISSUE_URL=https://github.com/ORG/REPO/issues/new?template=concept.yml&title=[{tax_name}/{concept_name}]
PUBLIC_GITHUB_ISSUE_URL=
# PUBLIC_BUILD_COMMIT — git commit the app was built from, shown (short, full on hover) in
# the footer so you can verify which release is live. CI bakes it into the published app
# image as a build arg, so it is not listed in docker-compose.yml (an empty entry there
# would overwrite the baked-in value). Pass it yourself when building the app image:
#   docker compose build --build-arg PUBLIC_BUILD_COMMIT=$(git rev-parse HEAD) frontend
# Unset ⇒ nothing is shown.

# ── vars-sync sidecar (optional, compose profile "sync") ──────────────────────
# Mirrors an upstream vars repo into the reference dataset on each push (polling).
# Start with: docker compose --profile sync up
VARS_REPO=
VARS_BRANCH=main
VARS_GITHUB_TOKEN=
# Seconds between tip checks.
VARS_POLL_INTERVAL=60
# The upstream package dir holding variables.py and the data files its snippets read. The
# sidecar lists it recursively, works out which file each variable needs, and stages both the
# files and a manifest so the API can attach them to the imported concepts.
VARS_MAPPING_DIR=src/corr_vars/sources/cub_hdp/mapping
# Repo paths fetched flat (by basename) into the reference dir. Empty = derived from
# VARS_MAPPING_DIR: vars.json, variables.py and the two parquet mappings.
VARS_FILES=
# Definitions-only sources synced alongside the one above, as `key=repo/dir` (comma-separated).
# They have no variables.py: no data-file scan, no pyapi — just their vars.json/units.json,
# staged as <key>_vars.json / <key>_units.json, the names REFERENCE_DATASETS reads. E.g.
#   VARS_EXTRA_SOURCES=reprodicu=src/corr_vars/sources/reprodicu/mapping
VARS_EXTRA_SOURCES=

# Optional: export per-concept clinical documentation from a Notion database (page title =
# canonical concept name). Whoever holds these credentials writes notion_docs.json into the
# reference dir, and the importer applies it on reimport. Column names map via
# sync/notion_fields.json.
# Both services read them: the sidecar refetches every NOTION_POLL_INTERVAL seconds, and the
# api pulls once at the start of `docker compose exec api python -m api.reimport` — which is
# how a deployment WITHOUT the sidecar keeps the documentation fresh. Leave them unset and
# the manual reimport skips the pull (and says so) instead of applying a stale export.
NOTION_API_KEY=
NOTION_DATABASE_ID=
NOTION_POLL_INTERVAL=600
# Column mapping used by the api's pull. Empty = notion_fields.json in the reference dir if
# present, else the default mapping built into api/notion_pull.py. Set a path (inside the
# container) to point at your own file; the sidecar reads the same variable.
NOTION_FIELDS_FILE=
# Taxonomy the page titles are resolved in when the importer applies the export
# (empty = the default taxonomy, corr_v1).
NOTION_DOCS_TAXONOMY=
